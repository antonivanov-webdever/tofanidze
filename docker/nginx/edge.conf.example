# Bare-metal nginx config for the VPS host — NOT part of the Docker stack.
# This is a TEMPLATE (hence .example): once you fill in the origin domain and
# secret path, the result contains values you don't want in version control,
# same reasoning as .env.example. Copy it to the server, fill it in there —
# e.g. as /etc/nginx/sites-available/default (or /etc/nginx/conf.d/edge.conf)
# — and don't commit the filled-in version back to this repo.
#
# Installed via `apt install nginx`, alongside Xray/3x-ui on the same host.
#
# This is the one thing on the box that owns :80/:443. It is the actual
# "origin" the CDN talks to. It routes traffic two ways:
#
#   - the VPN path ($secret_path below) → Xray, listening on 127.0.0.1:8080
#   - everything else                   → this Laravel app, via the
#                                          docker-compose.prod.yml stack's
#                                          nginx container, published as
#                                          127.0.0.1:8081 (see docker-compose.prod.yml)
#
# The Laravel site is the real "cover" — not a placeholder page. To anyone
# who isn't your VPN client (or anyone probing the origin IP directly), this
# is just a working portfolio site.
#
# Fill in before deploying:
#   - $origin_domain           the domain the CDN uses to reach this origin
#                               (the one with an A record pointing at this VPS —
#                               "cdn.yourdomain.com" in the guide's naming)
#   - $secret_path              must match streamSettings.xhttpSettings.path
#                               in the Xray inbound config
#   - fullchain.pem / privkey.pem paths from certbot, issued for $origin_domain
#
# Before relying on the real_ip block below in production: confirm YC CDN
# actually forwards the visitor's IP as X-Forwarded-For. Yandex's docs don't
# state this explicitly for Cloud CDN (they do for other products, e.g.
# Serverless Containers). Temporarily log $http_x_forwarded_for for a real
# request made through the CDN domain and check it's a plausible external IP,
# not blank or one of the CDN's own edge IPs, before trusting it for anything
# security-relevant.

# ── Real client IP from the CDN ─────────────────────────────────────────────
# Only trust a forwarded-IP header from connections that genuinely came from
# Yandex Cloud CDN's own edge ranges — anyone else (e.g. a request that
# reaches this VPS directly, bypassing the CDN) is treated as the raw TCP
# peer, which makes the header unspoofable unless the request already went
# through the CDN.
#
# yc-cdn-ips.conf is generated by refresh-yc-cdn-ips.sh from the official
# feed (https://tech.cdn.yandex.net/prefixes/yc.json) — see that script for
# the cron entry that keeps it current. It doesn't exist until you run it
# once; nginx will fail to start until you do.
include /etc/nginx/yc-cdn-ips.conf;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# IMPORTANT — this allowlist alone is not enough. Firewall the VPS itself
# (ufw/iptables/security group) so 80/443 only accept connections from the
# same CDN ranges. Anyone who finds this origin's real IP (it's a public A
# record) and connects directly bypasses both the CDN and this protection —
# for a VPN endpoint you're trying to keep off censors' radar, that's the
# whole ballgame, not just a header-spoofing nuisance.

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name _;

    ssl_certificate     /etc/letsencrypt/live/REPLACE_WITH_ORIGIN_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/REPLACE_WITH_ORIGIN_DOMAIN/privkey.pem;

    # ── VPN path: XHTTP → Xray ──────────────────────────────────────────────
    # Must match streamSettings.xhttpSettings.path in the Xray inbound.
    location /REPLACE_WITH_SECRET_PATH {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffer_size 32k;
        proxy_buffers 8 32k;
        client_max_body_size 0;
        add_header X-Accel-Buffering no always;
        add_header Cache-Control "no-store, no-transform" always;
        access_log /var/log/nginx/xhttp_access.log;
    }

    # ── Everything else: the real site ──────────────────────────────────────
    # Ordinary reverse proxy, no XHTTP-specific tuning — buffering stays on,
    # this is a normal web app (including its own /up health check; no need
    # for a separate fake one here now that a real site is behind this).
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
