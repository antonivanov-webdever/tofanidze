# Bare-metal nginx config for the RU Origin VPS — NOT part of the Docker stack.
# This is a TEMPLATE (hence .example): once you fill in the domain and secret
# path, the result contains values you don't want in version control, same
# reasoning as .env.example. Copy it to the server, fill it in there — e.g.
# as /etc/nginx/sites-available/default (or /etc/nginx/conf.d/edge.conf) —
# and don't commit the filled-in version back to this repo.
#
# Installed via `apt install nginx`, alongside Xray on the same host.
#
# ── Where this box sits in the chain ────────────────────────────────────────
#   Client -> Yandex Cloud CDN -> THIS SERVER (RU) -> Xray/Reality -> EU server
#                                                                     (nginx + this
#                                                                      Laravel app,
#                                                                      the real
#                                                                      internet exit)
#
# This RU box is a relay, not a website host: it terminates TLS from the CDN
# and routes every request two ways, it doesn't serve the site itself.
#
#   - the VPN path ($secret_path below) → local Xray XHTTP inbound on
#     127.0.0.1:8003 (see docker/xray/ru-origin-config.json.example), which
#     forwards on to the EU server over VLESS + Reality.
#   - everything else (the cover site) → reverse-proxied over WireGuard to
#     the EU server's nginx/Laravel stack at 10.66.66.2:8081 (see
#     docker/wireguard/ru-origin-wg0.conf.example and docker-compose.prod.yml,
#     which now runs on the EU box, not this one).
#
# The VPN path uses OPTIONS as the wire-level method (not GET, not POST) —
# this matches the "universal" Yandex Cloud CDN instruction this was built
# from, which tested it against the current CDN panel and ships its own
# verification step (see the debug location below — run the curl check
# from that instruction against your own CDN resource before trusting this;
# don't take either instruction's method choice on faith). A local `map`
# below turns OPTIONS back into POST only for the connection to Xray, since
# Xray's own inbound expects a normal method there — the CDN and any observer
# on the wire only ever see OPTIONS.
#
# Fill in before deploying:
#   - REPLACE_WITH_CERT_BASE_DOMAIN   the directory certbot created under
#                                       /etc/letsencrypt/live/ for the wildcard
#                                       cert (*.example.com) — this is your
#                                       APEX domain (example.com), NOT the
#                                       origin subdomain from Этап 1/DNS.
#                                       Wildcard certs are always filed under
#                                       the base domain's name regardless of
#                                       which subdomain they actually cover.
#                                       Run `ls /etc/letsencrypt/live/` and
#                                       use exactly what's there (watch for a
#                                       `-0001` suffix if issued more than once).
#   - REPLACE_WITH_SECRET_PATH        must match xhttpSettings.path in
#                                       docker/xray/ru-origin-config.json.example
#
# The origin subdomain itself (the one with the A record from Этап 1) never
# needs to be typed anywhere in this file — server_name below is a catch-all
# ("_"), and the wildcard cert covers it without naming it specifically.
#
# Before relying on the real_ip block below in production: confirm YC CDN
# actually forwards the visitor's IP as X-Forwarded-For. Yandex's docs don't
# state this explicitly for Cloud CDN (they do for other products, e.g.
# Serverless Containers). Temporarily log $http_x_forwarded_for for a real
# request made through the CDN domain and check it's a plausible external IP,
# not blank or one of the CDN's own edge IPs, before trusting it for anything
# security-relevant.

# ── Real client IP from the CDN ─────────────────────────────────────────────
# Only trust a forwarded-IP header from connections that genuinely came from
# Yandex Cloud CDN's own edge ranges — anyone else (e.g. a request that
# reaches this VPS directly, bypassing the CDN) is treated as the raw TCP
# peer, which makes the header unspoofable unless the request already went
# through the CDN.
#
# yc-cdn-ips.conf is generated by refresh-yc-cdn-ips.sh from the official
# feed (https://tech.cdn.yandex.net/prefixes/yc.json) — see that script for
# the cron entry that keeps it current. It doesn't exist until you run it
# once; nginx will fail to start until you do.
include /etc/nginx/yc-cdn-ips.conf;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# IMPORTANT — this allowlist alone is not enough. Firewall the VPS itself
# (ufw/iptables/security group) so 80/443 only accept connections from the
# same CDN ranges. Anyone who finds this origin's real IP (it's a public A
# record) and connects directly bypasses both the CDN and this protection —
# for a VPN endpoint you're trying to keep off censors' radar, that's the
# whole ballgame, not just a header-spoofing nuisance.

# OPTIONS on the wire (from the CDN) becomes POST for the local Xray inbound
# only. Everything else passes through unchanged.
map $request_method $xhttp_proxy_method {
    default  $request_method;
    OPTIONS  POST;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name _;

    ssl_certificate     /etc/letsencrypt/live/REPLACE_WITH_CERT_BASE_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/REPLACE_WITH_CERT_BASE_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 0;
    client_header_buffer_size 64k;
    # Covers what http2_max_field_size/http2_max_header_size used to handle
    # separately — both are obsolete in current nginx (merged into this
    # directive) and only produce a deprecation warning if left in, with no
    # effect either way. Needed because Xray's padding inflates header sizes
    # well past nginx's small defaults.
    large_client_header_buffers 8 128k;

    # Debug endpoint to verify OPTIONS-with-a-body actually survives the CDN
    # intact, before trusting the VPN path. This path and these header names
    # are copied from a public guide — same problem as the secret path and
    # xPaddingKey: identical across everyone who used it, so it's a trivial
    # thing to scan the whole internet for (an OPTIONS request to one fixed
    # path, checking for one fixed response header — cheaper than a CT-log
    # search, doesn't even need to know the domain). Rename the path and the
    # header names before using this, the same way as everything else here.
    #
    # DELETE THIS ENTIRE LOCATION BLOCK once the CDN pipeline is confirmed
    # working end to end (after this project's Этап 9) — it has no purpose
    # once setup is done, and the least fingerprintable debug endpoint is one
    # that no longer exists.
    location = /REPLACE_WITH_DEBUG_CHECK_PATH {
        add_header X-Debug-Origin "ok" always;
        add_header X-Debug-Method $request_method always;
        add_header X-Debug-Content-Length $http_content_length always;
        return 204;
    }

    # ── VPN path: XHTTP → local Xray → Reality → EU exit ────────────────────
    # Must match xhttpSettings.path in docker/xray/ru-origin-config.json.example.
    location /REPLACE_WITH_SECRET_PATH {
        proxy_pass http://127.0.0.1:8003;
        proxy_method $xhttp_proxy_method;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_pass_request_headers on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        access_log /var/log/nginx/xhttp_access.log;
    }

    # ── Everything else: the real site, relayed to the EU box ──────────────
    # Ordinary reverse proxy over the private WireGuard link, no XHTTP-specific
    # tuning — buffering stays on, this is a normal web app (including its own
    # /up health check; no need for a separate fake one here now that a real
    # site is behind this). 10.66.66.2 is the EU server's WireGuard address —
    # see docker/wireguard/ru-origin-wg0.conf.example. This link never touches
    # the public internet, so it doesn't need its own TLS: WireGuard already
    # encrypts it, and TLS from the CDN was already terminated above.
    location / {
        proxy_pass http://10.66.66.2:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
