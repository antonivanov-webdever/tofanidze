APP_NAME="Anton Tofanidze"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite keeps local development zero-setup. Switch to MySQL (the Docker
# default) by uncommenting the block below.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=portfolio
# DB_USERNAME=portfolio
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ────────────────────────────────────────────────────────────────────
# `log` writes contact form notifications to storage/logs/laravel.log.
# Use Mailpit (docker compose) or real SMTP credentials to actually send them.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="site@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Admin account ───────────────────────────────────────────────────────────
# Used once, by `php artisan db:seed`. Leave ADMIN_PASSWORD empty to have a
# strong one generated and printed to the console.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Docker compose ──────────────────────────────────────────────────────────
APP_PORT=8080
MAILPIT_PORT=8025
DB_PORT_FORWARD=3307
DB_ROOT_PASSWORD=root-secret

VITE_APP_NAME="${APP_NAME}"
